{
  "name": "dsh-mind-sea",
  "version": "1.1.0",
  "description": "小鲸鱼四层记忆框架（多域版）：L1 识海 + L2 日记，支持多个识海域与多份人设按会话绑定、共用、启动校对失效绑定。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "mind",
    "diary"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "private": true
}